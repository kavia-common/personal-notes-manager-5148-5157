<section class="notes-list">
  <div class="list-header">
    <h2>Notes</h2>
    <span id="result-count" class="muted">0 items</span>
  </div>
  <div id="notes-container" class="items" role="list"></div>
  <div id="empty-state" class="empty" hidden>
    <p>No notes found.</p>
    <button id="create-first" class="primary">Create your first note</button>
  </div>
</section>

<style>
  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    border-right: 1px solid var(--border-color);
    max-width: 380px;
    min-width: 280px;
    background: var(--bg-color);
  }
  .list-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .list-header h2 {
    margin: 0;
    font-size: 16px;
    color: var(--text-color);
  }
  .muted {
    color: var(--text-secondary);
    font-size: 12px;
  }
  .items {
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow: auto;
  }
  .note-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    padding: 12px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .note-card:hover {
    border-color: var(--primary-10, rgba(25,118,210,0.15));
    box-shadow: 0 2px 6px var(--shadow-color);
  }
  .note-card.active {
    outline: 2px solid var(--primary);
    outline-offset: 0px;
  }
  .note-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-color);
    margin: 0 0 4px 0;
  }
  .note-snippet {
    font-size: 12px;
    color: var(--text-secondary);
    margin: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .note-meta {
    font-size: 11px;
    color: var(--text-secondary);
    margin-top: 6px;
  }
  .actions {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }
  .icon-btn {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    border-radius: 8px;
    width: 32px; height: 32px;
    display: grid; place-items: center;
    cursor: pointer;
  }
  .icon-btn:hover { background: var(--card-hover-bg); }
  .empty {
    text-align: center;
    color: var(--text-secondary);
  }
  .primary {
    margin-top: 8px;
    padding: 8px 12px;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
  }

  @media (max-width: 1024px) {
    .notes-list {
      max-width: none;
      border-right: none;
      border-bottom: 1px solid var(--border-color);
    }
  }
</style>

<script type="module">
  import { store, NoteEvents } from '../lib/notesStore.ts';

  const container = document.getElementById('notes-container');
  const emptyState = document.getElementById('empty-state');
  const resultCount = document.getElementById('result-count');
  const createFirst = document.getElementById('create-first');

  if (createFirst) {
    createFirst.addEventListener('click', () => store.createNote());
  }

  function isRecentFilter(query: string): boolean {
    return query.trim().toLowerCase() === 'recent:24h';
  }

  function formatTime(ts: number): string {
    const d = new Date(ts);
    return d.toLocaleString();
  }

  function render() {
    if (!container) return;
    const q = store.getState().search;
    let notes = isRecentFilter(q)
      ? store.getNotes().filter(n => n.updatedAt >= Date.now() - 24*60*60*1000)
      : store.getFilteredNotes();

    // Update count and empty state
    if (resultCount) resultCount.textContent = `${notes.length} item${notes.length === 1 ? '' : 's'}`;
    if (emptyState) emptyState.hidden = notes.length > 0;

    // Replace list
    container.innerHTML = '';
    const activeId = store.getState().activeNoteId;

    notes.forEach(note => {
      const card = document.createElement('div');
      card.className = 'note-card' + (note.id === activeId ? ' active' : '');
      card.setAttribute('role', 'listitem');

      const left = document.createElement('div');
      const title = document.createElement('h3');
      title.className = 'note-title';
      title.textContent = note.title || 'Untitled note';

      const snippet = document.createElement('p');
      snippet.className = 'note-snippet';
      snippet.textContent = note.content ? note.content.replace(/\n+/g, ' ').slice(0, 140) : 'No content yet';

      const meta = document.createElement('div');
      meta.className = 'note-meta';
      meta.textContent = `Updated ${formatTime(note.updatedAt)}`;

      left.appendChild(title);
      left.appendChild(snippet);
      left.appendChild(meta);

      const actions = document.createElement('div');
      actions.className = 'actions';

      const del = document.createElement('button');
      del.className = 'icon-btn';
      del.title = 'Delete note';
      del.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24"><path d="M3 6h18M8 6l1-2h6l1 2m-1 0-.8 12a2 2 0 0 1-2 2H9.8a2 2 0 0 1-2-2L7 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
      del.addEventListener('click', (e) => {
        e.stopPropagation();
        const ok = confirm('Delete this note?');
        if (ok) store.deleteNote(note.id);
      });

      actions.appendChild(del);

      card.appendChild(left);
      card.appendChild(actions);

      card.addEventListener('click', () => {
        store.setActiveNote(note.id);
      });

      container.appendChild(card);
    });
  }

  render();

  const rerender = () => render();
  store.on(NoteEvents.NotesUpdated, rerender);
  store.on(NoteEvents.ActiveChanged, rerender);
  store.on(NoteEvents.SearchChanged, rerender);
</script>
